{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-website",
  "compatibility_date": "2026-08-16",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*"],
  },
}
